# .env.example — copy to .env and fill in your credentials
# Never commit a populated .env file.

LLM_API_KEY=your_llm_api_key_here

# Source DB (choose one)
SOURCE_DB_URL=postgresql://user:pass@localhost:5432/legacy_db

# Snowflake target (if using Snowflake)
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=MIGRATION_TARGET
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_ROLE=
SNOWFLAKE_AUTHENTICATOR=username_password_mfa
# 6-digit authenticator-app TOTP (expires ~30s). Leave blank after MFA token caching is enabled.
SNOWFLAKE_PASSCODE=

# BigQuery target (if using BigQuery)
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json
BIGQUERY_PROJECT_ID=your_gcp_project_id

# LangFuse Observability
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# Confidence threshold
CONFIDENCE_THRESHOLD=0.80

# ---------------------------------------------------------------------------
# Additional platform variables (documented for evaluators; not in the
# original snippet but required to run the reference implementation).
# ---------------------------------------------------------------------------

# LLM provider: openai | anthropic | none (heuristic fallback for local demo)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# Target warehouse: snowflake | bigquery | postgres | sqlite
TARGET_WAREHOUSE=sqlite
TARGET_DB_URL=sqlite:///./data/target_warehouse.db
SNOWFLAKE_SCHEMA=PUBLIC
BIGQUERY_DATASET=migration_target

# Optional MySQL source example:
# SOURCE_DB_URL=mysql+pymysql://user:pass@localhost:3306/legacy_db

# Local SQLite source used when Docker/Postgres is unavailable:
# SOURCE_DB_URL=sqlite:///./data/legacy_source.db

# Pipeline behaviour
TABLE_FILTER=
REVIEW_MODE=cli
REVIEW_FILE=./runs/latest/review_decisions.json
ENABLE_INCREMENTAL=false
WATERMARK_COLUMN=created_ts
MAX_RETRIES=4
RETRY_BASE_SECONDS=1.0
LOG_LEVEL=INFO
